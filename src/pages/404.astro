---
import Layout from '@/layouts/Layout.astro'
---

<Layout title='404 - Page Not Found'>
	<div class='min-h-[70vh] flex flex-col items-center justify-center text-center'>
		<h1 class='text-8xl font-black text-base-content mb-4'>404</h1>
		<h2 class='text-3xl font-bold text-base-content mb-6'>Page Not Found</h2>
		<p class='text-lg text-base-content/80 mb-8'>The page you requested could not be found.</p>
		<a href='/' class='btn btn-secondary text-secondary-content'>Go Home</a>
	</div>
</Layout>
