---
import Layout from '@/layouts/Layout.astro'
import { publications } from '@/data/cv'
import { formatPublicationVenue, highlightAuthor } from '@/lib/utils'
---

<Layout title='Publications | Yang Hu' description="Yang Hu's publications in theoretical computer science.">
	<div class='max-w-none'>
		<h1 class='text-3xl font-bold mb-3'>Publications</h1>
		<p class='text-sm text-base-content/70 mb-8'>In theoretical computer science, authors are typically listed alphabetically.</p>
		<ul class='ml-5 list-disc divide-y divide-base-300'>
			{
				publications.map((paper) => (
					<li class='py-5 first:pt-0 pl-1 marker:text-base-content/60'>
						<article>
							<h2 class='font-bold leading-snug'>{paper.title}</h2>
							<p class='mt-1 text-sm leading-relaxed' set:html={highlightAuthor(paper.authors)} />
							<p class='mt-1 text-sm'>
								<span class='font-bold'>{formatPublicationVenue(paper.journal, paper.time)}</span>
							{paper.link && (
								<>
									<span class='mx-1.5 text-base-content/50'>|</span>
									<a href={paper.link} target='_blank' rel='noreferrer' class='link link-secondary'>paper</a>
								</>
							)}
							</p>
						</article>
					</li>
				))
			}
		</ul>
	</div>
</Layout>
