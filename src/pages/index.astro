---
import Layout from '../layouts/Layout.astro'
import { profile } from '@/settings'
import { publications } from '@/data/cv'
import Hero from '@/components/ui/Hero.astro'
import ArticleList from '@/components/ui/ArticleList.astro'

const { fullName, title, institute, bio } = profile
---

<Layout>
	<section class='border-b pb-12'>
		<Hero
			fullName={fullName}
			title={title}
			institute={institute}
			bio={bio}
		/>
	</section>

	<section class='py-12'>
		<ArticleList listTitle='Recent Publications' listItems={publications.slice(0, 6)} />
		<div class='mt-8'>
			<a class='btn btn-secondary text-secondary-content' href='/papers'>View all publications</a>
		</div>
	</section>
</Layout>
