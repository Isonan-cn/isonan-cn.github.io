---
import { profile, template } from '@/settings'
import SocialIcons from './SocialIcons.astro'

const { fullName, title } = profile
---

<aside class='px-4 pt-4 h-screen w-[20rem] bg-base-200 text-base-content flex flex-col'>
	<div class='flex flex-col my-8 justify-between h-full'>
		<div>
			<div class='flex justify-center items-center flex-col'>
				<img
					class='mask mask-circle size-44 object-cover'
					src={`${template.base}/images/yang.jpg`}
					alt={`Profile picture of ${fullName}`}
					width='176'
					height='176'
				/>
				<h1 class='text-lg font-black mt-8 text-center'>
					<span class='block'>{fullName}</span>
					<span class='block mt-1 text-sm font-normal text-base-content/70'>{title}</span>
				</h1>
			</div>
			<nav class='mx-4 mt-14' aria-label='Main navigation'>
				<ul class='space-y-4 menu grow shrink menu-md overflow-y-auto'>
					<li><a href={`${template.base}/`} class='text-lg'>Home</a></li>
					<li><a href={`${template.base}/papers`} class='text-lg'>Papers</a></li>
					<li><a href={`${template.base}/files/resume.pdf`} class='text-lg'>CV</a></li>
				</ul>
			</nav>
		</div>
		<div class='mx-4'><SocialIcons /></div>
	</div>
</aside>
