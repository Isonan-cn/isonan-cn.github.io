---
import SocialIcons from './SocialIcons.astro'

interface Props {
	fullName: string
	title: string
	institute: string
	bio: string
}

const { fullName, title, institute, bio } = Astro.props
---

<div class='max-w-3xl'>
	<h1 class='text-4xl font-bold mb-4'>
		I'm <span class='text-secondary'>{fullName}</span>
	</h1>
	<p class='text-xl text-base-content/70 mb-5'>
		{title}{institute ? `, ${institute}` : ''}
	</p>
	<p class='text-lg leading-relaxed mb-4'>{bio}</p>
	<p class='text-lg leading-relaxed mb-7'>
		During the spring of 2025, I had a great time visiting
		<a class='link link-secondary' href='https://sites.google.com/site/williamkuszmaul'>William Kuszmaul</a>
		at CMU.
	</p>
	<div class='max-w-52'>
		<SocialIcons />
	</div>
</div>
